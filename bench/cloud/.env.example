# Copy to bench/cloud/.env (git-ignored) and fill in. Nothing secret goes here:
# the Anthropic key, for AI_MODE=api, goes straight into Secret Manager (up.sh says how).

# Your Google Cloud project ID (the ID, not the display name).
PROJECT_ID=
# One id per cost run: lowercase letters, digits, dashes. Becomes the cost-run label.
COST_RUN=baseline-20261002
REGION=us-east4

# AI in the cloud: local = author on this Mac with your Claude Code subscription
# and ship the recordings (option b); api = an Anthropic API key in Secret Manager (option a).
AI_MODE=local
MODEL=anthropic:claude-sonnet-5-5

# Task shape defaults (plan.json sets them per execution).
CPU=2
MEMORY_GIB=4
RETENTION_DAYS=7

# Android (MOB-3's scripts; their .env is scripts/android-vm/.env)
# ANDROID_VM_SCRIPTS=/path/to/engine-mob-3/scripts/android-vm
