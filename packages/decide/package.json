{
  "name": "@optestra/decide",
  "version": "0.1.0",
  "description": "The decision layer: small typed decisions answered by rules first, a decision model second, escalated below threshold.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "evals",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:evals": "node scripts/build-evals.ts && node scripts/build-evals-during.ts",
    "eval:baseline": "node scripts/write-baseline.ts"
  },
  "dependencies": {
    "@optestra/brand": "workspace:^",
    "@optestra/config": "workspace:^",
    "@optestra/contract": "workspace:^",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
