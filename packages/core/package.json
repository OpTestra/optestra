{
  "name": "@testament/core",
  "version": "0.1.0",
  "description": "The test engine.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "dependencies": {
    "@testament/brand": "workspace:^",
    "@testament/browser": "workspace:^",
    "@testament/config": "workspace:^",
    "@testament/contract": "workspace:^",
    "@testament/models": "workspace:^",
    "@testament/recording": "workspace:^",
    "@testament/spec": "workspace:^",
    "zod": "^4.6.5"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:browser": "tsc -b ../../bench/fixtures/shop . && vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@testament/fixture-shop": "workspace:*"
  }
}
