{
  "name": "@optestra/core",
  "version": "0.1.0",
  "description": "The test engine.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./bench": {
      "types": "./dist/bench/index.d.ts",
      "default": "./dist/bench/index.js"
    }
  },
  "dependencies": {
    "@optestra/android": "workspace:^",
    "@optestra/auth": "workspace:^",
    "@optestra/brand": "workspace:^",
    "@optestra/browser": "workspace:^",
    "@optestra/codegen": "workspace:^",
    "@optestra/config": "workspace:^",
    "@optestra/contract": "workspace:^",
    "@optestra/decide": "workspace:^",
    "@optestra/models": "workspace:^",
    "@optestra/recording": "workspace:^",
    "@optestra/spec": "workspace:^",
    "zod": "^4.6.5"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:browser": "tsc -b ../../bench/fixtures/shop . && vitest run --config vitest.config.ts",
    "bench:replay": "tsc -b ../../bench/fixtures/shop ../codegen . && node bench/replay.ts --equivalence",
    "perf": "tsc -b ../../bench/fixtures/shop ../codegen . && node bench/perf.ts",
    "bench:replay:android": "tsc -b ../../bench/fixtures/shop ../../bench/fixtures/android . && node bench/replay-android.ts",
    "test:android": "tsc -b ../../bench/fixtures/shop ../../bench/fixtures/android . && vitest run --config vitest.android.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@optestra/fixture-android": "workspace:*",
    "@optestra/fixture-shop": "workspace:*"
  }
}
