{
  "name": "@testament/spec",
  "version": "0.1.0",
  "description": "The test file format: parser, flows, variables, step keys and printer for .test.md files.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@testament/config": "workspace:^",
    "@testament/contract": "workspace:^",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
