{
  "name": "@optestra/recording",
  "version": "0.1.0",
  "description": "The recording format: what was done for each test step (commands, locators, fingerprints, waits) and the typed checks, replayed later without AI.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@optestra/brand": "workspace:^",
    "@optestra/spec": "workspace:^",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  }
}
