{
  "name": "@optestra/codegen",
  "version": "0.1.0",
  "description": "Generates plain Playwright specs from recordings: portable test code you own, no runtime needed.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "runtime"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:browser": "tsc -b ../../bench/fixtures/shop . && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@optestra/brand": "workspace:^",
    "@optestra/config": "workspace:^",
    "@optestra/recording": "workspace:^",
    "@optestra/spec": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@optestra/fixture-shop": "workspace:*",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
