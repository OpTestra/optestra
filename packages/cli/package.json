{
  "name": "@optestra/cli",
  "version": "0.1.0",
  "description": "Command-line interface for CI, coding agents and power users.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "optestra": "bin/cli.js"
  },
  "brand": {
    "bin": "cliName"
  },
  "dependencies": {
    "@optestra/android": "workspace:^",
    "@optestra/auth": "workspace:^",
    "@optestra/brand": "workspace:^",
    "@optestra/browser": "workspace:^",
    "@optestra/codegen": "workspace:^",
    "@optestra/config": "workspace:^",
    "@optestra/contract": "workspace:^",
    "@optestra/core": "workspace:^",
    "@optestra/decide": "workspace:^",
    "@optestra/mcp": "workspace:^",
    "@optestra/models": "workspace:^",
    "@optestra/recording": "workspace:^",
    "@optestra/report": "workspace:^",
    "@optestra/spec": "workspace:^",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@optestra/fixture-shop": "workspace:*"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:browser": "tsc -b ../../bench/fixtures/shop . && vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
