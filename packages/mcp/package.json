{
  "name": "@optestra/mcp",
  "version": "0.1.0",
  "description": "MCP server for coding agents: list, draft, save and run tests, read results, accept heals (stdio, local projects).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./instructions": {
      "types": "./dist/instructions.d.ts",
      "default": "./dist/instructions.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test:browser": "tsc -b ../../bench/fixtures/shop ../cli && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@optestra/brand": "workspace:^",
    "@optestra/config": "workspace:^",
    "@optestra/contract": "workspace:^",
    "@optestra/core": "workspace:^",
    "@optestra/models": "workspace:^",
    "@optestra/recording": "workspace:^",
    "@optestra/report": "workspace:^",
    "@optestra/spec": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@optestra/fixture-shop": "workspace:*",
    "ajv": "^8.20.0"
  },
  "engines": {
    "node": ">=24"
  }
}
