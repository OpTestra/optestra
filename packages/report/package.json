{
  "name": "@optestra/report",
  "version": "0.1.0",
  "description": "Turns a results-contract run folder into an offline HTML report, JUnit XML, JSON, a Markdown summary and terminal output.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./schema/results-summary.json": "./dist/schema/results-summary.schema.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b && node dist/write-schema.js",
    "test:browser": "tsc -b . && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@optestra/brand": "workspace:^",
    "@optestra/contract": "workspace:^"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "ajv": "^8.20.0",
    "axe-core": "4.13.0"
  }
}
